---
interface Props {
  title: string;
  description: string;
  activeView: "upcoming" | "recent" | "calendar" | "bingo";
}

const { title, description, activeView } = Astro.props;
const navigation = [
  { label: "Upcoming", href: "/", key: "upcoming" },
  { label: "Recently aired", href: "/recently-aired", key: "recent" },
  { label: "Calendar", href: "/calendar", key: "calendar" },
  { label: "Bingo", href: "/bingo", key: "bingo" },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f5ed" />
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem("countdown-theme");
        document.documentElement.dataset.theme = savedTheme === "dark" || savedTheme === "light"
          ? savedTheme
          : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      } catch {
        document.documentElement.dataset.theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
    </script>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <title>{title} · Countdown to Christmas</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="Countdown to Christmas home">
          <span class="brand-mark" aria-hidden="true">✳</span>
          <span class="brand-name">a very merry<br /><strong>watch list</strong></span>
        </a>
        <div class="header-actions">
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to dark mode" title="Switch to dark mode">
            <span aria-hidden="true">☾</span>
          </button>
          <span class="season-label"><span class="season-dot"></span> The 2026 season</span>
        </div>
      </header>

      <main id="main-content">
        <section class="hero" aria-labelledby="page-title">
          <div class="hero-copy">
            <p class="eyebrow">Hallmark Channel · Countdown to Christmas</p>
            <h1 id="page-title">Make room for<br /><em>a little magic.</em></h1>
            <p class="hero-description">Your cozy guide to every new holiday movie and episode this season.</p>
          </div>
          <div class="hero-art" aria-hidden="true">
            <span class="art-star star-one">✳</span>
            <span class="art-star star-two">✦</span>
            <span class="art-snow">❄</span>
            <span class="art-caption">the most<br />wonderful<br /><i>time to watch</i></span>
            <span class="art-base"></span>
          </div>
        </section>

        <nav class="view-nav" aria-label="Site navigation">
          {navigation.map((item) => (
            <a
              href={item.href}
              class:list={["view-link", { active: activeView === item.key }]}
              aria-current={activeView === item.key ? "page" : undefined}
            >
              {item.label}
              {item.key === "upcoming" && <span class="nav-sparkle" aria-hidden="true">✦</span>}
            </a>
          ))}
        </nav>

        <slot />
      </main>

      <footer class="site-footer">
        <span class="footer-sparkle" aria-hidden="true">✳</span>
        <p>Made for the most wonderful time of the year.</p>
        <p class="fine-print">A fan-made schedule guide. Air times are shown as listed (ET/PT); dates are used for the aired / upcoming split.</p>
      </footer>
    </div>
    <script>
      const themeToggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
      if (themeToggle) {
        const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
        const updateThemeButton = () => {
          const isDark = document.documentElement.dataset.theme === "dark";
          const label = isDark ? "Switch to light mode" : "Switch to dark mode";
          themeToggle.setAttribute("aria-label", label);
          themeToggle.title = label;
          themeToggle.setAttribute("aria-pressed", String(isDark));
          const icon = themeToggle.querySelector("span");
          if (icon) icon.textContent = isDark ? "☀" : "☾";
          if (themeColor) themeColor.content = isDark ? "#111d18" : "#f8f5ed";
        };
        updateThemeButton();
        themeToggle.addEventListener("click", () => {
          const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = nextTheme;
          try {
            localStorage.setItem("countdown-theme", nextTheme);
          } catch {
            // The theme still works for this page when storage is unavailable.
          }
          updateThemeButton();
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --cream: #f8f5ed;
    --paper: #fffdf8;
    --ink: #1d332a;
    --muted: #777a6e;
    --green: #174b3b;
    --green-dark: #10382d;
    --red: #a83c36;
    --gold: #c79a53;
    --line: #e8e2d5;
    --soft: #f7f4eb;
    --soft-green: #edf2e9;
    --soft-gold: #f4eddf;
    --soft-border: #eee9df;
    --dash-border: #e7e0d2;
    --selected-bg: var(--green);
    --disabled: #bcb9ad;
    --font-body: "Gotham-Book", Arial, sans-serif;
    --font-medium: "Gotham-Medium", Arial, sans-serif;
    --font-bold: "Gotham-Bold", Arial, sans-serif;
    --font-display: "Albra-Grotesk-Regular", Arial, sans-serif;
    --font-display-bold: "Albra-Grotesk-Black", "Arial Black", Arial, sans-serif;
    font-family: var(--font-body);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    background: var(--cream);
    color: var(--ink);
    font-synthesis: none;
    text-rendering: optimizeLegibility;
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    --cream: #111d18;
    --paper: #1b2a23;
    --ink: #f0eee3;
    --muted: #b3b8aa;
    --green: #b8d4c2;
    --green-dark: #dce8d9;
    --red: #e58d83;
    --gold: #d8ba7c;
    --line: #35463d;
    --soft: #24352c;
    --soft-green: #2c4034;
    --soft-gold: #3a3427;
    --soft-border: #35463d;
    --dash-border: #435349;
    --selected-bg: #41634f;
    --disabled: #778078;
  }

  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; background: var(--cream); }
  a { color: inherit; }
  button { font: inherit; }
  button:focus-visible, a:focus-visible { outline: 3px solid var(--gold); outline-offset: 4px; }
  .skip-link { position: absolute; top: 0.75rem; left: 0.75rem; z-index: 10; transform: translateY(-160%); padding: .7rem 1rem; border-radius: 999px; background: var(--ink); color: white; }
  .skip-link:focus { transform: translateY(0); }
  .site-shell { width: min(1100px, calc(100% - 48px)); margin: 0 auto; }
  .site-header { display: flex; justify-content: space-between; align-items: center; padding: 24px 0; }
  .header-actions { display: flex; align-items: center; gap: 20px; }
  .theme-toggle { display: grid; width: 36px; height: 36px; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: var(--paper); color: var(--green); font-size: 17px; cursor: pointer; }
  .theme-toggle:hover { border-color: var(--gold); background: var(--soft); }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand-mark { display: grid; width: 38px; height: 38px; place-items: center; border: 1px solid var(--gold); border-radius: 50%; color: var(--red); font-size: 23px; }
  .brand-name { color: var(--green); font-family: var(--font-display-bold); font-size: 12px; letter-spacing: .04em; line-height: 1.02; text-transform: uppercase; }
  .brand-name strong { font-size: 15px; letter-spacing: .09em; }
  .season-label { display: inline-flex; align-items: center; gap: 9px; color: var(--muted); font-family: var(--font-bold); font-size: 11px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  .season-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 4px #a83c361a; }
  .hero { position: relative; display: flex; min-height: 340px; align-items: center; overflow: hidden; border-radius: 9px; background: var(--green); color: #e7e9df; }
  .hero::before { position: absolute; inset: 0; background: radial-gradient(ellipse at 73% 110%, #34614a 0, transparent 47%), linear-gradient(105deg, #123c30 0%, #174b3b 60%, #1a513f 100%); content: ""; }
  .hero-copy { position: relative; z-index: 1; width: 62%; padding: 48px 8%; }
  .eyebrow { margin: 0 0 17px; color: #d9c295; font-family: var(--font-medium); font-size: 10px; font-weight: 700; letter-spacing: .17em; text-transform: uppercase; }
  h1 { margin: 0; font-family: var(--font-display-bold); font-size: clamp(42px, 6vw, 70px); font-weight: 400; letter-spacing: -.045em; line-height: .99; }
  h1 em { color: #e9d4aa; font-weight: 400; }
  .hero-description { max-width: 330px; margin: 21px 0 0; color: #e7e9df; font-size: 14px; line-height: 1.65; }
  .hero-art { position: absolute; top: 0; right: 0; width: 42%; height: 100%; overflow: hidden; }
  .art-star, .art-snow { position: absolute; color: #e5d3a6; }
  .star-one { top: 22%; right: 27%; font-size: 27px; }
  .star-two { top: 33%; right: 13%; font-size: 18px; color: #fff7e6; }
  .art-snow { top: 17%; right: 48%; color: #ffffff8c; font-size: 15px; }
  .art-caption { position: absolute; right: 13%; bottom: 20%; color: #e6d5b0; font-family: var(--font-display); font-size: 23px; line-height: 1.05; text-align: right; transform: rotate(-5deg); }
  .art-caption i { color: #fff7e6; font-size: 19px; }
  .art-base { position: absolute; right: -5%; bottom: -52%; width: 110%; aspect-ratio: 1; border: 1px solid #e6d5b044; border-radius: 50%; box-shadow: 0 0 0 27px #e6d5b00a, 0 0 0 54px #e6d5b00a; }
  .view-nav { display: flex; gap: 31px; margin: 31px 0 34px; border-bottom: 1px solid var(--line); }
  .view-link { position: relative; display: inline-flex; align-items: center; gap: 7px; padding: 0 0 14px; color: var(--muted); font-size: 13px; font-weight: 650; text-decoration: none; }
  .view-link:hover { color: var(--green); }
  .view-link.active { color: var(--green); }
  .view-link.active::after { position: absolute; right: 0; bottom: -1px; left: 0; height: 2px; background: var(--red); content: ""; }
  .nav-sparkle { color: var(--red); font-size: 10px; }
  .page-intro { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 20px; margin: 0 0 22px; }
  .section-kicker { margin: 0 0 7px; color: var(--red); font-family: var(--font-bold); font-size: 10px; font-weight: 750; letter-spacing: .16em; text-transform: uppercase; }
  .section-title { margin: 0; color: var(--green-dark); font-family: var(--font-display-bold); font-size: clamp(28px, 4vw, 39px); font-weight: 400; letter-spacing: -.035em; }
  .section-copy { margin: 7px 0 0; color: var(--muted); font-size: 13px; line-height: 1.55; }
  .page-intro-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-left: auto; }
  .countdown-cards { display: flex; gap: 8px; }
  .countdown-card { display: grid; align-content: start; gap: 4px; min-width: 135px; max-width: 180px; padding: 9px 11px; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); }
  .countdown-label { color: var(--red); font-family: var(--font-bold); font-size: 9px; font-weight: 750; letter-spacing: .09em; text-transform: uppercase; }
  .countdown-value { color: var(--green-dark); font-family: var(--font-display-bold); font-size: 15px; font-weight: 400; line-height: 1.2; }
  .countdown-detail { overflow-wrap: anywhere; color: var(--ink); font-size: 10px; font-weight: 650; line-height: 1.35; }
  .countdown-date { color: var(--muted); font-size: 10px; line-height: 1.35; }
  .event-count { flex: 0 0 auto; padding: 8px 12px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font-size: 11px; }
  .schedule-groups { display: grid; gap: 13px; }
  .schedule-day { overflow: hidden; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); }
  .schedule-day[hidden] { display: none; }
  .day-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 19px; border-bottom: 1px solid var(--soft-border); }
  .day-heading h3 { margin: 0; color: var(--green); font-family: var(--font-bold); font-size: 12px; font-weight: 750; letter-spacing: .02em; }
  .day-heading time { color: var(--muted); font-size: 11px; }
  .day-heading-badges { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 7px; }
  .double-badge, .day-counter, .event-note { display: inline-flex; align-items: center; border-radius: 99px; font-size: 9px; font-weight: 750; letter-spacing: .05em; text-transform: uppercase; }
  .double-badge { padding: 5px 8px; background: var(--soft-gold); color: var(--gold); }
  .day-counter { padding: 5px 8px; background: var(--soft-border); color: var(--muted); }
  .event-list { margin: 0; padding: 0; list-style: none; }
  .event-item { display: flex; align-items: flex-start; gap: 15px; padding: 17px 19px; }
  .event-item + .event-item { border-top: 1px dashed var(--dash-border); }
  .event-time { flex: 0 0 48px; padding-top: 3px; color: var(--red); font-family: var(--font-bold); font-size: 11px; font-weight: 750; }
  .event-poster { flex: 0 0 112px; width: 112px; aspect-ratio: 4 / 3; height: auto; border-radius: 5px; object-fit: cover; }
  .event-poster--movie { aspect-ratio: 2 / 3; }
  .event-content { flex: 1; min-width: 0; }
  .event-title { margin: 0; color: var(--ink); font-family: var(--font-display); font-size: 18px; font-weight: 400; line-height: 1.25; }
  .event-title a { color: inherit; text-decoration-color: transparent; text-underline-offset: 3px; transition: color .15s ease, text-decoration-color .15s ease; }
  .event-title a:hover { color: var(--green); text-decoration-color: currentColor; }
  .external-link-icon { color: var(--red); font-family: sans-serif; font-size: 12px; }
  .event-note { margin: 6px 0 0; padding: 4px 7px; background: var(--soft-green); color: var(--green); }
  .event-details { display: grid; gap: 6px; margin-top: 11px; }
  .event-details p { margin: 0; font-size: 11px; line-height: 1.55; }
  .event-premiere { color: var(--muted); }
  .event-premiere span, .event-starring span { margin-right: 5px; color: var(--green); font-size: 9px; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .event-starring { color: var(--ink); }
  .event-synopsis { max-width: 760px; color: var(--muted); }
  .empty-state { padding: 27px; border: 1px dashed #d9d1c1; border-radius: 8px; color: var(--muted); font-size: 14px; text-align: center; }
  .date-note { margin: 17px 0 0; color: var(--muted); font-size: 11px; line-height: 1.5; }
  .site-footer { display: grid; justify-items: center; gap: 7px; margin: 62px 0 25px; padding: 22px 10px 0; border-top: 1px solid var(--line); color: var(--green); text-align: center; }
  .footer-sparkle { color: var(--red); font-size: 18px; }
  .site-footer p { margin: 0; font-family: var(--font-display); font-size: 15px; }
  .site-footer .fine-print { max-width: 550px; margin-top: 3px; color: var(--muted); font-family: inherit; font-size: 10px; line-height: 1.5; }

  .calendar-panel { padding: 22px; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); }
  .calendar-toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
  .calendar-toolbar h3 { margin: 0; color: var(--green); font-family: var(--font-display-bold); font-size: 24px; font-weight: 400; }
  .month-controls { display: flex; gap: 8px; }
  .month-button { display: grid; width: 36px; height: 36px; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: transparent; color: var(--green); cursor: pointer; }
  .month-button:hover:not(:disabled) { border-color: var(--green); background: var(--soft-green); }
  .month-button:disabled { color: #bcb9ad; cursor: not-allowed; }
  .calendar-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .calendar-table th { padding: 9px 4px; color: var(--muted); font-family: var(--font-bold); font-size: 10px; font-weight: 700; text-align: center; text-transform: uppercase; }
  .calendar-table td { height: 70px; padding: 3px; border: 1px solid var(--soft-border); text-align: center; vertical-align: middle; }
  .calendar-day { display: flex; width: 100%; height: 100%; min-height: 62px; flex-direction: column; align-items: center; justify-content: center; gap: 5px; border: 0; border-radius: 5px; background: transparent; color: var(--ink); cursor: pointer; }
  .calendar-day:hover { background: var(--soft); }
  .calendar-day.selected { background: var(--selected-bg); color: white; }
  .calendar-day.today:not(.selected) .day-number { color: var(--red); font-weight: 800; }
  .calendar-day:disabled { color: var(--disabled); cursor: default; }
  .day-number { font-family: var(--font-display); font-size: 17px; }
  .calendar-mark { display: flex; gap: 3px; height: 5px; }
  .calendar-mark i { width: 5px; height: 5px; border-radius: 50%; background: var(--red); }
  .calendar-day.selected .calendar-mark i { background: #f1d7a4; }
  .date-details { margin-top: 20px; padding-top: 19px; border-top: 1px solid var(--line); }
  .date-details h4 { margin: 0 0 12px; color: var(--green); font-family: var(--font-display-bold); font-size: 21px; font-weight: 400; }
  .calendar-events { display: grid; gap: 8px; }
  .calendar-event { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 5px; background: var(--soft); }
  .calendar-event time { flex: 0 0 48px; color: var(--red); font-size: 11px; font-weight: 750; }
  .calendar-event p { margin: 0; font-family: var(--font-display); font-size: 16px; line-height: 1.3; }
  .calendar-event small { display: block; margin-top: 3px; color: var(--green); font-family: inherit; font-size: 9px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .calendar-empty { color: var(--muted); font-size: 13px; }
  .calendar-legend { display: flex; flex-wrap: wrap; gap: 17px; margin-top: 17px; color: var(--muted); font-size: 10px; }
  .legend-item { display: inline-flex; align-items: center; gap: 7px; }
  .legend-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--red); }
  .legend-dot.past { background: #bcb9ad; }
  .calendar-range-note { margin: 13px 0 0; color: var(--muted); font-size: 10px; line-height: 1.5; }

  @media (min-width: 768px) {
    .schedule-groups { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .schedule-day { grid-column: span 6; }
  }

  @media (max-width: 650px) {
    .site-shell { width: min(100% - 30px, 520px); }
    .site-header { padding: 17px 0; }
    .header-actions { gap: 10px; }
    .theme-toggle { width: 32px; height: 32px; }
    .season-label { font-size: 9px; letter-spacing: .09em; }
    .hero { min-height: 310px; }
    .hero-copy { width: 78%; padding: 38px 25px; }
    .hero-art { width: 35%; opacity: .64; }
    .eyebrow { max-width: 210px; font-size: 8px; line-height: 1.5; }
    .hero-description { max-width: 260px; font-size: 12px; }
    .art-caption { right: 7%; font-size: 16px; }
    .art-caption i { font-size: 14px; }
    .view-nav { gap: 22px; margin: 23px 0 27px; }
    .view-link { font-size: 11px; }
    .page-intro { align-items: start; }
    .page-intro-meta { width: 100%; margin-left: 0; }
    .countdown-cards { flex: 1 1 100%; }
    .countdown-card { flex: 1 1 0; min-width: 0; }
    .section-copy { max-width: 280px; }
    .event-count { align-self: center; margin-left: auto; font-size: 10px; }
    .day-heading { padding: 12px 13px; }
    .event-item { gap: 11px; padding: 15px 13px; }
    .event-time { flex-basis: 43px; }
    .event-poster { flex-basis: 76px; width: 76px; }
    .event-title { font-size: 17px; }
    .event-details { margin-top: 9px; }
    .event-details p { font-size: 11px; }
    .calendar-panel { padding: 14px 10px; }
    .calendar-table td { height: 55px; padding: 2px; }
    .calendar-day { min-height: 48px; }
    .calendar-table th { font-size: 8px; }
    .day-number { font-size: 15px; }
    .calendar-toolbar h3 { font-size: 21px; }
    .month-button { width: 32px; height: 32px; }
    .calendar-event { gap: 8px; padding: 11px 9px; }
    .site-footer { margin-top: 44px; }
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) {
      color-scheme: dark;
      --cream: #111d18;
      --paper: #1b2a23;
      --ink: #f0eee3;
      --muted: #b3b8aa;
      --green: #b8d4c2;
      --green-dark: #dce8d9;
      --red: #e58d83;
      --gold: #d8ba7c;
      --line: #35463d;
      --soft: #24352c;
      --soft-green: #2c4034;
      --soft-gold: #3a3427;
      --soft-border: #35463d;
      --dash-border: #435349;
      --selected-bg: #41634f;
      --disabled: #778078;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .view-link, .month-button, .calendar-day, .theme-toggle { transition: color .15s ease, background-color .15s ease, border-color .15s ease; }
  }
</style>
