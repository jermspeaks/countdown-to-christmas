---
import { groupScheduleByDate, schedule } from "../data/schedule";
import { getScheduleDetails } from "../data/details";
import { getScheduleListPoster } from "../data/posters";

interface Props {
  mode: "upcoming" | "recent";
}

const { mode } = Astro.props;
const now = new Date();
const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
const groups = [...groupScheduleByDate().entries()]
  .sort(([left], [right]) => mode === "recent" ? right.localeCompare(left) : left.localeCompare(right));
const visibleCount = schedule.filter((item) => mode === "recent" ? item.date < today : item.date >= today).length;
const formatDate = (date: string, options: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat("en-US", { ...options, timeZone: "UTC" }).format(new Date(`${date}T12:00:00Z`));
const dayDifference = (targetDate: string, referenceDate: string) => {
  const [year, month, day] = targetDate.split("-").map(Number);
  const [referenceYear, referenceMonth, referenceDay] = referenceDate.split("-").map(Number);
  return Math.round(
    (Date.UTC(year, month - 1, day) - Date.UTC(referenceYear, referenceMonth - 1, referenceDay)) / 86_400_000,
  );
};
const formatCountdown = (days: number) => days === 0 ? "Today" : `${days} ${days === 1 ? "day" : "days"} away`;
const formatSinceRelease = (days: number) => days === 0 ? "Today" : `${days} ${days === 1 ? "day" : "days"} ago`;
const nextEvent = schedule.find((item) => item.date >= today);
const lastEvent = [...schedule].filter((item) => item.date < today).sort((left, right) => right.date.localeCompare(left.date))[0];
const counterEvent = mode === "recent" ? lastEvent : nextEvent;
const releaseDays = counterEvent ? dayDifference(today, counterEvent.date) : null;
const releaseCountdown = releaseDays === null
  ? mode === "recent" ? "No releases yet" : "Season complete"
  : mode === "recent" ? formatSinceRelease(releaseDays) : formatCountdown(-releaseDays);
// const christmasDate = `${Number(today.slice(0, 4)) + (today > `${today.slice(0, 4)}-12-25` ? 1 : 0)}-12-25`;
// const christmasCountdown = today === christmasDate ? "It's Christmas!" : formatCountdown(dayDifference(christmasDate, today));
const formatDayCounter = (date: string, referenceDate: string) => {
  const days = dayDifference(date, referenceDate);
  if (days === 0) return "0 days";
  const count = Math.abs(days);
  const label = `${count} ${count === 1 ? "day" : "days"}`;
  return days > 0 ? `${label} away` : `${label} ago`;
};
---

<div class="page-intro">
  <div>
    <h2 class="section-title">{mode === "upcoming" ? "Coming up next" : "Recently aired"}</h2>
    <p class="section-copy">
      {mode === "upcoming"
        ? "All the new holiday premieres and episodes still to come."
        : "A look back at the season's newest holiday stories."}
    </p>
  </div>
  <div class="page-intro-meta">
    <div class="countdown-cards" aria-label="Holiday countdowns">
      <section class="countdown-card" aria-label={mode === "recent" ? "Time since the last release" : "Countdown to the next scheduled broadcast"}>
        <span class="countdown-label">{mode === "recent" ? "Last release" : "Next broadcast"}</span>
        <strong class="countdown-value" data-release-countdown>{releaseCountdown}</strong>
        <span class="countdown-detail" data-release-title>{counterEvent?.title ?? (mode === "recent" ? "No releases yet" : "No more broadcasts scheduled")}</span>
        {counterEvent && <time class="countdown-date" data-release-date datetime={counterEvent.date}>{formatDate(counterEvent.date, { weekday: "long", month: "long", day: "numeric" })}</time>}
      </section>
    </div>
    <span class="event-count" data-event-count>{visibleCount} {visibleCount === 1 ? "title" : "titles"}</span>
  </div>
</div>

<div class="schedule-groups" data-schedule-list data-list-mode={mode}>
  {groups.map(([date, events]) => {
    const shouldShow = mode === "recent" ? date < today : date >= today;
    const isDouble = events.length > 1;
    return (
      <section class="schedule-day" data-event-date={date} hidden={!shouldShow} aria-label={formatDate(date, { weekday: "long", month: "long", day: "numeric" })}>
        <header class="day-heading">
          <h3>{formatDate(date, { weekday: "long", month: "long", day: "numeric" })}</h3>
          <div class="day-heading-badges">
            <span class="day-counter" data-day-counter>{formatDayCounter(date, today)}</span>
            {isDouble && <span class="double-badge">Double feature</span>}
          </div>
        </header>
        <ul class="event-list">
          {events.map((item) => {
            const details = getScheduleDetails(item.id);
            const poster = getScheduleListPoster(item.title);
            return (
              <li class="event-item" data-event-title={item.title}>
                <!-- <time class="event-time" datetime={item.date}>{item.timeLabel}</time> -->
                <img class:list={["event-poster", { "event-poster--movie": poster.format === "movie" }]} src={poster.src} alt={poster.alt} loading="lazy" decoding="async" width="112" height={poster.format === "movie" ? 168 : 84} />
                <div class="event-content">
                  <p class="event-title">
                    <a href={details.url} target="_blank" rel="noopener noreferrer">
                      {item.title}<span class="external-link-icon" aria-hidden="true"> ↗</span>
                    </a>
                  </p>
                  {item.notes && <span class="event-note">{item.notes}</span>}
                  <div class="event-details">
                    <p class="event-premiere"><span>Premiere</span> {details.premiereDate}</p>
                    <p class="event-starring"><span>{details.castLabel}</span> {details.starring}</p>
                    <p class="event-synopsis">{details.synopsis}</p>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    );
  })}
</div>
<p class="empty-state" data-empty-state hidden>
  {mode === "upcoming" ? "The season's schedule is all wrapped up. Check back next year!" : "Nothing has aired yet. The holiday fun starts soon!"}
</p>
<p class="date-note">Countdowns are date-based because exact broadcast times aren’t provided. Listed times retain Hallmark's original ET/CT notation.</p>

<script>
  const list = document.querySelector<HTMLElement>("[data-schedule-list]");
  if (list) {
    const mode = list.dataset.listMode;
    const getLocalDate = () => {
      const now = new Date();
      return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
    };
    const dayDifference = (targetDate: string, referenceDate: string) => {
      const [year, month, day] = targetDate.split("-").map(Number);
      const [referenceYear, referenceMonth, referenceDay] = referenceDate.split("-").map(Number);
      return Math.round(
        (Date.UTC(year, month - 1, day) - Date.UTC(referenceYear, referenceMonth - 1, referenceDay)) / 86_400_000,
      );
    };
    const formatCountdown = (days: number) => days === 0 ? "Today" : `${days} ${days === 1 ? "day" : "days"} away`;
    const formatSinceRelease = (days: number) => days === 0 ? "Today" : `${days} ${days === 1 ? "day" : "days"} ago`;
    const formatLongDate = (date: string, options: Intl.DateTimeFormatOptions) =>
      new Intl.DateTimeFormat("en-US", { ...options, timeZone: "UTC" }).format(new Date(`${date}T12:00:00Z`));
    const updateCountdowns = (today: string, groups: HTMLElement[]) => {
      const counterGroup = groups
        .filter((group) => {
          const date = group.dataset.eventDate ?? "";
          return mode === "recent" ? date < today : date >= today;
        })
        .sort((left, right) => {
          const leftDate = left.dataset.eventDate ?? "";
          const rightDate = right.dataset.eventDate ?? "";
          return mode === "recent" ? rightDate.localeCompare(leftDate) : leftDate.localeCompare(rightDate);
        })[0];
      const counterDate = counterGroup?.dataset.eventDate;
      const counterTitle = counterGroup?.querySelector<HTMLElement>(".event-item")?.dataset.eventTitle;
      const counterValue = document.querySelector<HTMLElement>("[data-release-countdown]");
      const counterTitleLabel = document.querySelector<HTMLElement>("[data-release-title]");
      const counterDateLabel = document.querySelector<HTMLTimeElement>("[data-release-date]");
      if (counterValue) {
        if (!counterDate) counterValue.textContent = mode === "recent" ? "No releases yet" : "Season complete";
        else {
          const days = dayDifference(counterDate, today);
          counterValue.textContent = mode === "recent" ? formatSinceRelease(-days) : formatCountdown(days);
        }
      }
      if (counterTitleLabel) counterTitleLabel.textContent = counterTitle ?? (mode === "recent" ? "No releases yet" : "No more broadcasts scheduled");
      if (counterDateLabel) {
        counterDateLabel.hidden = !counterDate;
        if (counterDate) {
          counterDateLabel.dateTime = counterDate;
          counterDateLabel.textContent = formatLongDate(counterDate, { weekday: "long", month: "long", day: "numeric" });
        }
      }

      const currentYear = Number(today.slice(0, 4));
      const thisChristmas = `${currentYear}-12-25`;
      const targetChristmas = today <= thisChristmas ? thisChristmas : `${currentYear + 1}-12-25`;
      const christmasCountdown = document.querySelector<HTMLElement>("[data-christmas-countdown]");
      const christmasDateLabel = document.querySelector<HTMLTimeElement>("[data-christmas-date]");
      if (christmasCountdown) {
        christmasCountdown.textContent = today === targetChristmas
          ? "It's Christmas!"
          : formatCountdown(dayDifference(targetChristmas, today));
      }
      if (christmasDateLabel) {
        christmasDateLabel.dateTime = targetChristmas;
        christmasDateLabel.textContent = formatLongDate(targetChristmas, { month: "long", day: "numeric", year: "numeric" });
      }
    };
    const updateList = () => {
      const today = getLocalDate();
      const groups = [...list.querySelectorAll<HTMLElement>("[data-event-date]")];
      let count = 0;
      for (const group of groups) {
        const date = group.dataset.eventDate ?? "";
        const visible = mode === "recent" ? date < today : date >= today;
        const days = dayDifference(date, today);
        const dayCount = Math.abs(days);
        const label = `${dayCount} ${dayCount === 1 ? "day" : "days"}`;
        const dayCounter = group.querySelector<HTMLElement>("[data-day-counter]");
        if (dayCounter) dayCounter.textContent = days === 0 ? "0 days" : days > 0 ? `${label} away` : `${label} ago`;
        group.hidden = !visible;
        if (visible) count += group.querySelectorAll(".event-item").length;
      }
      updateCountdowns(today, groups);
      const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");
      if (emptyState) emptyState.hidden = count > 0;
      const countLabel = document.querySelector<HTMLElement>("[data-event-count]");
      if (countLabel) countLabel.textContent = `${count} ${count === 1 ? "title" : "titles"}`;
    };
    updateList();
    const refreshAtMidnight = () => {
      const now = new Date();
      const nextMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
      window.setTimeout(() => {
        updateList();
        refreshAtMidnight();
      }, nextMidnight.getTime() - now.getTime());
    };
    refreshAtMidnight();
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") updateList();
    });
  }
</script>
